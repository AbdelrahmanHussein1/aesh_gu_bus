      "id": "b4e1d8d4-5a0a-44c6-91c3-4d1f8d487d81",
      "name": "Webhook - Booking Confirmation",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-960, 80],
      "webhookId": "b4e1d8d4-5a0a-44c6-91c3-4d1f8d487d81"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body ?? input;\n\nconst required = ['studentName', 'studentId', 'studentEmail', 'route', 'pickup', 'dropoff', 'date', 'departureTime', 'returnTime', 'seatNumber', 'price', 'bookingRef', 'paymentRef'];\nconst missing = required.filter((key) => body[key] === undefined || body[key] === null || body[key] === '');\nif (missing.length) {\n  throw new Error(`Missing ticket fields: ${missing.join(', ')}`);\n}\n\nfunction makeManualCode() {\n  const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n  let code = '';\n  for (let index = 0; index < 6; index += 1) {\n    code += alphabet[Math.floor(Math.random() * alphabet.length)];\n  }\n  return code;\n}\n\nfunction buildLeg(leg) {\n  const manualCode = makeManualCode();\n  return {\n    manualCode,\n    qrPayload: JSON.stringify({\n      ref: body.bookingRef,\n      sid: body.studentId,\n      leg,\n      manualCode,\n      t: 'galala-bus-v1',\n    }),\n  };\n}\n\nconst departure = buildLeg('departure');\nconst returned = buildLeg('return');\n\nreturn [{\n  json: {\n    studentName: body.studentName,\n    studentId: String(body.studentId),\n    studentEmail: body.studentEmail,\n    route: body.route,\n    pickup: body.pickup,\n    dropoff: body.dropoff,\n    date: body.date,\n    departureTime: body.departureTime,\n    returnTime: body.returnTime,\n    seatNumber: body.seatNumber,\n    returnSeatNumber: body.returnSeatNumber ?? body.seatNumber,\n    price: body.price,\n    bookingRef: body.bookingRef,\n    paymentRef: body.paymentRef,\n    departure,\n    return: returned,\n\n    // Existing check-in sheet column names are kept unchanged.\n    ref: body.bookingRef,\n    name: body.studentName,\n    phone: body.phone ?? '',\n    email: body.studentEmail,\n    time: body.departureTime,\n    status: 'booked',\n    boarded: false,\n    createdAt: new Date().toISOString(),\n  },\n}];"
      },
      "id": "9c1b7a9e-04a2-4dc6-86e7-070ce2bc1210",
      "name": "Build Ticket Codes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-720, 80]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&format=png&data=' + encodeURIComponent($json.departure.qrPayload) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "qr_departure"
            }
          }
        }
      },
      "id": "827ca736-3d81-4cce-8e95-40ceae5f7d63",
      "name": "Generate Departure QR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-460, 80]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&format=png&data=' + encodeURIComponent($json.return.qrPayload) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "qr_return"
            }
          }
        }
      },
      "id": "afb4d700-9a43-450e-8f0a-4b6fc6853ba5",
      "name": "Generate Return QR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-220, 80]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst inlineImages = [\n  ['qr_departure', 'ticketqr_departure'],\n  ['qr_return', 'ticketqr_return'],\n];\n\nfor (const [property, contentId] of inlineImages) {\n  const image = item.binary?.[property];\n  if (!image) throw new Error(`Missing binary QR image: ${property}`);\n\n  image.fileName = `${contentId}.png`;\n  image.mimeType = 'image/png';\n  // Retain the desired CID metadata with the binary item for the email node.\n  image.contentId = contentId;\n  image.contentDisposition = 'inline';\n}\n\nreturn [item];"
      },
      "id": "2c4814bd-00fa-4f59-af23-396befbb5d7e",
