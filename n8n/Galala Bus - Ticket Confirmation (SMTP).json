      "parameters": {
        "fromEmail": "your.email@example.com",
        "toEmail": "={{ $json.studentEmail }}",
        "subject": "=Bus ticket confirmed — {{ $json.bookingRef }}",
        "html": "=<div style=\"font-family:Arial,sans-serif;max-width:620px;margin:0 auto;background:#10141d;color:#f8fafc;border-radius:18px;overflow:hidden;\">\n  <div style=\"padding:28px 30px;background:linear-gradient(135deg,#111827,#26354a);border-bottom:1px solid #3b4758;\">\n    <div style=\"color:#60a5fa;font-size:14px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;\">Galala University Transport</div>\n    <h1 style=\"margin:8px 0 0;font-size:26px;line-height:1.2;color:#ffffff;\">Your bus ticket is confirmed</h1>\n  </div>\n  <div style=\"padding:28px 30px;\">\n    <div style=\"display:inline-block;padding:7px 11px;border:1px solid #475569;border-radius:999px;color:#cbd5e1;font-family:monospace;font-size:13px;\">REF {{ $json.bookingRef }}</div>\n    <table style=\"width:100%;border-collapse:collapse;margin:22px 0 18px;font-size:14px;\">\n      <tr><td style=\"padding:8px 0;color:#94a3b8;width:38%;\">Student</td><td style=\"padding:8px 0;color:#ffffff;font-weight:700;\">{{ $json.studentName }}</td></tr>\n      <tr><td style=\"padding:8px 0;color:#94a3b8;\">Student ID</td><td style=\"padding:8px 0;color:#ffffff;\">{{ $json.studentId }}</td></tr>\n      <tr><td style=\"padding:8px 0;color:#94a3b8;\">Route / date</td><td style=\"padding:8px 0;color:#ffffff;\">{{ $json.route }} · {{ $json.date }}</td></tr>\n      <tr><td style=\"padding:8px 0;color:#94a3b8;\">Pickup / drop-off</td><td style=\"padding:8px 0;color:#ffffff;\">{{ $json.pickup }} → {{ $json.dropoff }}</td></tr>\n      <tr><td style=\"padding:8px 0;color:#94a3b8;\">Seat / price</td><td style=\"padding:8px 0;color:#ffffff;font-weight:700;\">{{ $json.seatNumber }} · {{ $json.price }}</td></tr>\n    </table>\n\n    <div style=\"margin-top:20px;padding:22px;background:#182231;border-left:4px solid #38bdf8;border-radius:10px;text-align:center;\">\n      <h2 style=\"margin:0 0 8px;color:#7dd3fc;font-size:18px;\">Departure</h2>\n      <div style=\"color:#cbd5e1;font-size:13px;margin-bottom:14px;\">{{ $json.departureTime }} · Seat {{ $json.seatNumber }}</div>\n      <img src=\"cid:ticketqr_departure\" width=\"220\" height=\"220\" alt=\"Departure QR code\" style=\"display:block;margin:0 auto;background:#ffffff;border-radius:10px;padding:8px;\" />\n      <div style=\"margin-top:14px;color:#94a3b8;font-size:12px;\">Backup boarding code</div>\n      <div style=\"font-family:monospace;font-size:23px;font-weight:700;letter-spacing:4px;color:#ffffff;margin-top:4px;\">{{ $json.departure.manualCode }}</div>\n    </div>\n\n    <div style=\"margin-top:16px;padding:22px;background:#182231;border-left:4px solid #a78bfa;border-radius:10px;text-align:center;\">\n      <h2 style=\"margin:0 0 8px;color:#c4b5fd;font-size:18px;\">Return</h2>\n      <div style=\"color:#cbd5e1;font-size:13px;margin-bottom:14px;\">{{ $json.returnTime }} · Seat {{ $json.returnSeatNumber }}</div>\n      <img src=\"cid:ticketqr_return\" width=\"220\" height=\"220\" alt=\"Return QR code\" style=\"display:block;margin:0 auto;background:#ffffff;border-radius:10px;padding:8px;\" />\n      <div style=\"margin-top:14px;color:#94a3b8;font-size:12px;\">Backup boarding code</div>\n      <div style=\"font-family:monospace;font-size:23px;font-weight:700;letter-spacing:4px;color:#ffffff;margin-top:4px;\">{{ $json.return.manualCode }}</div>\n    </div>\n  </div>\n  <div style=\"padding:17px 30px;background:#0b0f16;color:#94a3b8;font-size:11px;text-align:center;\">Present the relevant QR code or backup code when boarding.</div>\n</div>",
        "options": {
