{
  "name": "bus-aesh-monorepo",
  "version": "1.3.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "build:all": "npm run build --workspaces --if-present",
    "package:release": "node scripts/package-release.mjs",
    "package:vbox": "node scripts/package-release.mjs --vbox",
    "serve:zip": "node scripts/serve-zip.js",
    "install:all": "npm install",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "overrides": {
    "expo-linking": "~6.3.1"
  }
}
